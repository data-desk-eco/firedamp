#!/usr/bin/env python3
# duckduckgo lite search: websearch "<query>" -> title / url / snippet
import html, re, sys, urllib.parse as up, urllib.request as ur

q = " ".join(sys.argv[1:]) or sys.exit("usage: websearch <query>")
req = ur.Request("https://lite.duckduckgo.com/lite/?q=" + up.quote(q),
                 headers={"User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)"})
t = ur.urlopen(req, timeout=25).read().decode("utf-8", "replace")
strip = lambda s: html.unescape(re.sub("<[^>]+>", "", s)).strip()
links = re.findall(r"<a rel=\"nofollow\" href=\"([^\"]+)\"[^>]*>(.*?)</a>", t)
snips = re.findall(r"class='result-snippet'>(.*?)</td>", t, re.S)
for (u, ti), s in list(zip(links, snips + [""] * len(links)))[:8]:
    m = re.search(r"uddg=([^&]+)", u)
    print(f"{strip(ti)}\n  {up.unquote(m.group(1)) if m else u}\n  {strip(s)}\n")
